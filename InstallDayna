.KEY STATIC/S
.BRA {
.KET }
; InstallDayna - installs scsidayna.device PLUS a Roadshow network setup
;
;   Execute InstallDayna          the interface gets its address, gateway
;                                 and DNS server by DHCP (the default)
;   Execute InstallDayna STATIC   a fixed address instead - the example LAN
;                                 below (192.168.86.36, gateway and DNS
;                                 192.168.86.1); edit it for your own
;
; Writes:
;   DEVS:Networks/scsidayna.device
;   C:daynawifi                          (if it is in this drawer)
;   ENVARC:scsidayna.prefs + ENV: copy   (set AUTOCONNECT=1 + SSID/KEY)
;   DEVS:NetInterfaces/scsidayna         (DHCP, or the static address)
;   DEVS:Internet/Routes                 (STATIC only: default gateway)
;   DEVS:Internet/name_resolution        (STATIC only: DNS server)
; Existing config files are NOT overwritten (so re-running is safe on an
; already-tuned machine) - it says "kept existing" instead.
;
; Run from the drawer containing scsidayna.device and scsidayna.prefs.

If NOT EXISTS DEVS:Networks
  MakeDir DEVS:Networks
EndIf
Copy scsidayna.device DEVS:Networks/ CLONE QUIET
Echo "Installed DEVS:Networks/scsidayna.device"
If EXISTS daynawifi
  Copy daynawifi C: CLONE QUIET
  Protect C:daynawifi +e
  Echo "Installed C:daynawifi (the adapter's Wi-Fi: status, REJOIN, SCAN)"
EndIf

If EXISTS ENVARC:scsidayna.prefs
  Echo "kept existing ENVARC:scsidayna.prefs"
Else
  Copy scsidayna.prefs ENVARC:scsidayna.prefs CLONE QUIET
  Echo "Installed ENVARC:scsidayna.prefs (check SSID/KEY inside!)"
EndIf
Copy ENVARC:scsidayna.prefs ENV:scsidayna.prefs CLONE QUIET

If NOT EXISTS DEVS:NetInterfaces
  MakeDir DEVS:NetInterfaces
EndIf
If EXISTS DEVS:NetInterfaces/scsidayna
  Echo "kept existing DEVS:NetInterfaces/scsidayna"
Else
  If "{STATIC}" EQ "STATIC"
    Echo >DEVS:NetInterfaces/scsidayna "device=scsidayna.device"
    Echo >>DEVS:NetInterfaces/scsidayna "address=192.168.86.36"
    Echo >>DEVS:NetInterfaces/scsidayna "netmask=255.255.255.0"
    Echo "Wrote DEVS:NetInterfaces/scsidayna (static 192.168.86.36)"
  Else
    Echo >DEVS:NetInterfaces/scsidayna "device=scsidayna.device"
    Echo >>DEVS:NetInterfaces/scsidayna "configure=dhcp"
    Echo "Wrote DEVS:NetInterfaces/scsidayna (DHCP)"
  EndIf
EndIf

If "{STATIC}" EQ "STATIC"
  If NOT EXISTS DEVS:Internet
    MakeDir DEVS:Internet
  EndIf
  If EXISTS DEVS:Internet/Routes
    Echo "kept existing DEVS:Internet/Routes"
  Else
    Echo >DEVS:Internet/Routes "default 192.168.86.1"
    Echo "Wrote DEVS:Internet/Routes (gateway 192.168.86.1)"
  EndIf
  If EXISTS DEVS:Internet/name_resolution
    Echo "kept existing DEVS:Internet/name_resolution"
  Else
    Echo >DEVS:Internet/name_resolution "nameserver 192.168.86.1"
    Echo "Wrote DEVS:Internet/name_resolution (DNS 192.168.86.1)"
  EndIf
EndIf

Echo ""
If "{STATIC}" EQ "STATIC"
  Echo "Done. Reboot (or start your stack) - Roadshow will bring up"
  Echo "scsidayna.device on 192.168.86.36."
Else
  Echo "Done. Reboot (or start your stack) - Roadshow will bring up"
  Echo "scsidayna.device and ask the network for an address by DHCP."
EndIf
Echo "For troubleshooting set DEBUG=1 in ENVARC:scsidayna.prefs and"
Echo "re-copy it to ENV:."
